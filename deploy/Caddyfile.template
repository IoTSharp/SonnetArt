{$SONNET_ART_PUBLIC_ORIGIN} {
	encode zstd gzip
	root * /srv

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	handle_path /api/sonnet/* {
		rewrite * /api/v1{path}
		reverse_proxy {$SONNET_ART_ACCOUNT_UPSTREAM_URL} {
			header_up Host {upstream_hostport}
			header_up X-Forwarded-Host {host}
			header_down X-SonnetArt-Proxy "1"
		}
	}

	handle_path /api/openai/* {
		reverse_proxy {$SONNET_ART_AI_UPSTREAM_URL} {
			header_up Host {upstream_hostport}
			header_up X-Forwarded-Host {host}
			header_down X-SonnetArt-Proxy "1"
		}
	}

	handle {
		try_files {path} /index.html
		file_server
	}
}

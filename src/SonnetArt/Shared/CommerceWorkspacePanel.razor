    [
        new("plan", "整套方案"),
        new("node", "当前节点"),
        new("favorites", "已选片"),
    ];
    private static readonly ExportOption[] ExportImageSelectionOptions =
    [
        new("selected-or-all", "选片优先"),
        new("selected", "仅选片"),
        new("all", "全部图片"),
    ];
    private static readonly ExportOption[] ExportResolutionOptions =
    [

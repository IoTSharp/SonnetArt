@if (Open)
{
    <div class="workspace-create-backdrop" @onclick="Cancel">
        <section class="workspace-create-dialog" role="dialog" aria-modal="true" aria-labelledby="workspace-create-title" @onclick:stopPropagation>
            <header>
                <div>
                    <span class="workspace-eyebrow">工作空间</span>
                    <h2 id="workspace-create-title">新建工作空间</h2>
                </div>
                <button type="button" title="关闭" @onclick="Cancel">
                    <Icon Type="close" Theme="IconThemeType.Outline" />
                </button>
            </header>

            <div class="workspace-type-segment" role="tablist" aria-label="工作空间类型">
                <button type="button" class='@TypeClass("copy")' @onclick='() => SetType("copy")'>
                    <Icon Type="file-text" Theme="IconThemeType.Outline" />
                    <span>文案空间</span>
                </button>
                <button type="button" class='@TypeClass("graphic")' @onclick='() => SetType("graphic")'>
                    <Icon Type="picture" Theme="IconThemeType.Outline" />
                    <span>作图空间</span>
                </button>
                <button type="button" class='@TypeClass("commerce-product-image")' @onclick='() => SetType("commerce-product-image")'>
                    <Icon Type="shopping" Theme="IconThemeType.Outline" />
                    <span>电商产品图</span>
                </button>
            </div>

            <div class="studio-field">
                <label class="studio-label">名称</label>
                <input class="studio-input" autocomplete="off" value="@Name" @oninput="UpdateName" />
            </div>

            <footer>
                <button type="button" class="studio-button studio-button-light" @onclick="Cancel">
                    <span>取消</span>
                </button>
                <button type="button" class="studio-button studio-button-primary" @onclick="Create">
                    <Icon Type="plus" Theme="IconThemeType.Outline" />
                    <span>创建</span>
                </button>
            </footer>
        </section>
    </div>
}

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public string Name { get; set; } = string.Empty;
    [Parameter] public string Type { get; set; } = "copy";
    [Parameter] public EventCallback<string> NameChanged { get; set; }
    [Parameter] public EventCallback<string> TypeChanged { get; set; }
    [Parameter] public EventCallback OnCreate { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private string TypeClass(string type)
    {
        return string.Equals(Type, type, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
    }

    private Task SetType(string type)
    {
        return TypeChanged.InvokeAsync(type);
    }

    private Task UpdateName(ChangeEventArgs args)
    {
        return NameChanged.InvokeAsync(args.Value?.ToString() ?? string.Empty);
    }

    private Task Create()
    {
        return OnCreate.InvokeAsync();
    }

    private Task Cancel()
    {
        return OnCancel.InvokeAsync();
    }
}
